# Example env file for Tekno-Alumil-Site
# Copy this file to .env and fill the actual values.

# EmailJS settings
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_VERIFICATION_ID=your_emailjs_template_verification_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_EMAILJS_USER_ID=your_emailjs_user_id

# Google reCAPTCHA
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key

